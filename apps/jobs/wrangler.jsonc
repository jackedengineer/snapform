{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "snapform-jobs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EMAIL_FROM": "Snapform <no-reply@jacked.dev>",
    "PURGE_ENABLED": "0",
    // "1" turns on owner alerts and "drill" sends a labelled test alert
    // (docs/runbooks/alerts.md).
    "OPERATIONS_ENABLED": "0",
  },
  "r2_buckets": [
    { "binding": "PURGE_LEDGER", "bucket_name": "snapform-purge-ledger" },
    // Respondent files, deleted by prefix before a purge is finalized.
    { "binding": "UPLOADS", "bucket_name": "snapform-uploads" },
    // One small status object, readable while the database is down or asleep.
    { "binding": "OPERATIONS", "bucket_name": "snapform-operations" },
  ],
  // Every 30 minutes: retries, deletions and anything a submit's instant wake
  // missed. Running every minute kept the database from ever sleeping and used
  // Neon's free compute allowance in about 17 days.
  "triggers": { "crons": ["*/30 * * * *"] },
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "snapform-response-events" }],
    "consumers": [
      {
        "queue": "snapform-response-events",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "snapform-response-dead",
      },
    ],
  },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
}
