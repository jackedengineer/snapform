# Runtime only. Never put DATABASE_MIGRATION_URL here.
DATABASE_URL="postgresql://snapform_runtime:replace@your-host.neon.tech/snapform?sslmode=require"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-bytes"
BETTER_AUTH_URL="http://127.0.0.1:5173"
RESEND_API_KEY="replace-with-a-domain-scoped-sending-key"
EMAIL_FROM="Snapform <no-reply@jacked.dev>"
# Keep local sends scoped to the explicitly approved owner address.
AUTH_ALLOWED_RECIPIENT="your-approved-address@example.com"
# One stable 32-byte base64 key shared with Jobs and production for this database.
# Preserve it in encrypted recovery material; changing it makes saved endpoints unreadable.
WEBHOOK_ENCRYPTION_KEY="replace-with-base64-encoded-32-random-bytes"
# Razorpay TEST MODE only. A key that does not start with rzp_test_ leaves billing
# unconfigured; live keys and live charges are not supported.
RAZORPAY_KEY_ID="rzp_test_replace"
RAZORPAY_KEY_SECRET="replace-with-the-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-the-test-webhook-secret"
# Plan IDs from Dashboard > Subscriptions > Plans (test mode), one per price.
RAZORPAY_PLAN_PRO_MONTHLY_INR="plan_replace"
RAZORPAY_PLAN_PRO_MONTHLY_USD="plan_replace"
RAZORPAY_PLAN_PRO_ANNUAL_INR="plan_replace"
RAZORPAY_PLAN_PRO_ANNUAL_USD="plan_replace"
