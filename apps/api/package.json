{
  "name": "@snapform/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --config ../jobs/wrangler.jsonc --local --ip 127.0.0.1 --port 8787 --inspector-port 0 --log-level warn",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types worker-configuration.d.ts",
    "test:integration": "node --env-file-if-exists=.dev.vars ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@snapform/contracts": "workspace:*",
    "@snapform/database": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0"
  }
}
