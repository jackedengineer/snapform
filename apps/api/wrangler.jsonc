{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "snapform-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SNAPFORM_ENV": "production",
    "BETTER_AUTH_URL": "https://snapform.jacked.dev",
    "EMAIL_FROM": "Snapform <no-reply@jacked.dev>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFq-UmrCxZJJpkUN",
  },
  "ratelimits": [
    {
      "name": "EXPORT_RATE_LIMIT",
      "namespace_id": "1006",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "WRITE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "PUBLIC_READ_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "INTAKE_START_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "INTAKE_WRITE_RATE_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
}
