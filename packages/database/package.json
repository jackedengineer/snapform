{
  "name": "@snapform/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./schema": "./src/schema.ts",
    "./workspaces": "./src/workspaces.ts",
    "./workspace-schema": "./src/workspace-schema.ts",
    "./forms": "./src/forms.ts",
    "./publication": "./src/publication.ts",
    "./public-form": "./src/public-form.ts",
    "./intake": "./src/intake.ts",
    "./outbox": "./src/outbox.ts",
    "./responses": "./src/responses.ts",
    "./notification-delivery": "./src/notification-delivery.ts",
    "./notification-settings": "./src/notification-settings.ts",
    "./response-export": "./src/response-export.ts",
    "./webhook-settings": "./src/webhook-settings.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "@snapform/contracts": "workspace:*"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "test": "node --env-file-if-exists=../../apps/api/.dev.vars ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "bootstrap": "node --env-file-if-exists=../../.env src/bootstrap.ts",
    "bootstrap:jobs": "node --env-file-if-exists=../../.env src/bootstrap-jobs.ts",
    "verify:email-delivery": "node --experimental-transform-types --env-file=../../.env scripts/verify-email-delivery.ts",
    "verify:webhook-intents": "node --experimental-transform-types --env-file=../../.env scripts/verify-webhook-intents.ts"
  }
}
