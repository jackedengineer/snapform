        "workspace_name_length": {
          "name": "workspace_name_length",
          "value": "length(trim(\"workspace\".\"name\")) between 2 and 80"
        },
        "workspace_segment": {
          "name": "workspace_segment",
          "value": "\"workspace\".\"segment\" in ('agency', 'coach', 'consultant', 'startup')"
