          "for": "SELECT",
          "to": ["snapform_runtime"],
          "using": "exists (select 1 from public.membership m where m.workspace_id = \"workspace\".\"id\" and m.user_id = current_setting('snapform.user_id', true))"
        },
        "workspace_create": {
          "name": "workspace_create",
          "as": "PERMISSIVE",
          "for": "INSERT",
          "to": ["snapform_runtime"],
          "withCheck": "\"workspace\".\"id\"::text = current_setting('snapform.workspace_id', true) and \"workspace\".\"created_by\" = current_setting('snapform.user_id', true)"
        },
        "workspace_update": {
          "name": "workspace_update",
          "as": "PERMISSIVE",
          "for": "UPDATE",
          "to": ["snapform_runtime"],
          "using": "\"workspace\".\"id\"::text = current_setting('snapform.workspace_id', true) and current_setting('snapform.role', true) = 'owner'",
